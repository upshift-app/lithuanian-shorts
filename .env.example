# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET / service_role key. Server-side only, never in a browser.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# Signs the login cookie. Any long random string; changing it signs everybody out.
FLASK_SECRET_KEY=change-me-to-something-long-and-random

# Optional: only needed for `python run.py enrich` (AI keyword suggestions).
OPENROUTER_API_KEY=
