{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "ls_tool/**",
        "maxLambdaSize": "45mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/sync-films",
      "schedule": "0 4 * * 1"
    }
  ]
}
